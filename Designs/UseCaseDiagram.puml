@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #0B3D6B
skinparam usecase {
  BackgroundColor #EAF3FB
  BorderColor #0B3D6B
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #0B3D6B
}
title AI Student Affairs System - Use Case Diagram

' ===== Primary actors =====
actor "Student" as Student
actor "Affairs Staff" as Staff
actor "Admin" as Admin

' ===== External / secondary actors =====
actor "AI Agent" as AI <<external>>
actor "Email Service" as Email <<external>>
actor "Financial DB" as FinDB <<external>>

rectangle "AI Student Affairs System" {

  ' --- Student ---
  usecase "UC-01\nAsk Regulation Question" as UC01
  usecase "UC-02\nReport Problem &\nCreate Ticket" as UC02
  usecase "UC-03\nClassify Ticket" as UC03
  usecase "UC-04\nTrack Ticket" as UC04
  usecase "UC-05\nUpload Attachment" as UC05
  usecase "UC-06\nReceive Email\nNotification" as UC06

  ' --- Affairs Staff ---
  usecase "UC-07\nView & Filter Tickets" as UC07
  usecase "UC-08\nUpdate Ticket Status" as UC08
  usecase "UC-09\nResolve Ticket" as UC09
  usecase "Add Resolution\nComment" as UC09a
  usecase "UC-10\nVerify Payment\nTransaction" as UC10
  usecase "Check Transaction ID" as UC10a
  usecase "UC-11\nReject Ticket" as UC11

  ' --- Admin ---
  usecase "UC-12\nManage Knowledge Base" as UC12
  usecase "UC-13\nManage Staff Accounts" as UC13
  usecase "UC-14\nGenerate Performance\nReport" as UC14
  usecase "UC-15\nExport Report as CSV" as UC15

  ' --- Shared ---
  usecase "UC-16\nLogin & Authorize" as UC16
}

' ===== Actor associations =====
Student --> UC01
Student --> UC02
Student --> UC04
Student --> UC05
Student --> UC06

Staff --> UC07
Staff --> UC08
Staff --> UC09
Staff --> UC10
Staff --> UC11

Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15

UC01 -- AI
UC02 -- AI
UC03 -- AI
UC06 -- Email
UC10a -- FinDB

' ===== Include relationships =====
UC02 ..> UC03 : <<include>>
UC09 ..> UC09a : <<include>>
UC10 ..> UC10a : <<include>>

' ===== Extend relationships (arrow points to the base use case) =====
UC05 ..> UC02 : <<extend>>
UC06 ..> UC09 : <<extend>>
UC09 ..> UC08 : <<extend>>
UC11 ..> UC10 : <<extend>>
UC15 ..> UC14 : <<extend>>

' ===== Knowledge Base feeds the AI answers =====
UC12 ..> UC01 : <<feeds>>

' ===== Login: included by all Staff and Admin use cases =====
note right of UC16
  UC-07, UC-08, UC-10,
  UC-12, UC-13, UC-14
  <<include>> UC-16
end note

' Uncomment to draw the include arrows explicitly (makes the diagram crowded):
' UC07 ..> UC16 : <<include>>
' UC08 ..> UC16 : <<include>>
' UC10 ..> UC16 : <<include>>
' UC12 ..> UC16 : <<include>>
' UC13 ..> UC16 : <<include>>
' UC14 ..> UC16 : <<include>>

@enduml
